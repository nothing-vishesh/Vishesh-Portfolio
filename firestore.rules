rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'connect.visheshjaiswal@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'role', 'feedback', 'createdAt', 'isApproved']) &&
             data.keys().size() == 5 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.feedback is string && data.feedback.size() > 0 && data.feedback.size() <= 1000 &&
             data.role is string && data.role.size() <= 100 &&
             data.createdAt == request.time &&
             data.isApproved == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reviews collection rules
    match /reviews/{reviewId} {
      // Allow anyone to read approved reviews
      allow list: if resource.data.isApproved == true;
      allow get: if resource.data.isApproved == true || isAdmin();

      // Allow anyone to create a review, default to not approved for security/moderation
      // or set to true if user wants it "automatic"
      allow create: if isValidId(reviewId) && 
                      isValidReview(request.resource.data) &&
                      request.resource.data.isApproved == true; // Auto-approve for this requirement

      // Only admin can delete or update reviews
      allow update, delete: if isAdmin();
    }
  }
}
